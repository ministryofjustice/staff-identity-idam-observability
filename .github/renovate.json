{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":enableVulnerabilityAlerts"
  ],
  "automerge": false,
  "enabledManagers": [
    "terraform",
    "github-actions",
    "pre-commit"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "* 4-7 * * 1"
  ],
  "terraform": {
    "managerFilePatterns": [
      "/\\.tf$/"
    ]
  },
  "prCreation": "immediate",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Terraform providers - non-major updates (5 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "provider"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Terraform providers (non-major)",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Terraform providers - major updates (30 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "provider"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Terraform providers (major)",
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Terraform modules - non-major updates (5 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Terraform modules (non-major)",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Terraform modules - major updates (30 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Terraform modules (major)",
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Terraform required_version - non-major updates (5 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Terraform version (non-major)",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Terraform required_version - major updates (30 day stabilisation)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Terraform version (major)",
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "GitHub Actions - non-major updates (5 day stabilisation)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions (non-major)",
      "groupSlug": "github-actions-non-major",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "GitHub Actions - major updates (30 day stabilisation)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "GitHub Actions (major)",
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "pre-commit hooks - non-major updates (5 day stabilisation)",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "pre-commit hooks (non-major)",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "pre-commit hooks - major updates (30 day stabilisation)",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "pre-commit hooks (major)",
      "minimumReleaseAge": "30 days"
    }
  ]
}

